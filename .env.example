# ============================================================================
# P_174 Environment Variables Template (.env.example)
# ============================================================================

# Database Configuration
POSTGRES_DB=safety_wearable_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/safety_wearable_db

# MQTT Broker Configuration
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=SafetyWearableBackend

# Backend API Configuration
BACKEND_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api

# Configurable Safety Thresholds
SAFETY_THRESHOLD_HEART_RATE_MAX=110
SAFETY_THRESHOLD_SPO2_MIN=92
SAFETY_THRESHOLD_TEMPERATURE_MAX=38.0
SAFETY_ALERT_PERSISTENCE_SECONDS=15
SAFETY_ALERT_COOLDOWN_SECONDS=60
SAFETY_DEVICE_OFFLINE_TIMEOUT_SECONDS=30
